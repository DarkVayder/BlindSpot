{
  "name": "@blindspot/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Estimate file-level comprehension risk in a git repository, locally.",
  "type": "module",
  "bin": {
    "blindspot": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@blindspot/core": "workspace:*",
    "@blindspot/engine": "workspace:*",
    "@blindspot/report": "workspace:*",
    "commander": "^15.1.0"
  }
}
